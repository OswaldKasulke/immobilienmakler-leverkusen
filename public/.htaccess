DirectoryIndex index.html

RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.leverkusen-makler\.de$ [NC]
RewriteRule ^ https://leverkusen-makler.de%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

# Sicherheitsheader, derselbe Satz wie auf romanbecker.de.
# Die CSP listet genau das, was die Seite wirklich laedt:
#   'unsafe-inline' bei script/style: der statische Next-Export schreibt
#     Inline-Skripte und -Styles in jede Seite, ein Nonce ist ohne Server
#     nicht moeglich.
#   images.ctfassets.net: Objektbilder aus dem Evernest-CMS.
#   romanbecker.de: bewertung-adressen.php (Adresssuche im Rechner) und
#     submit.php (Lead-Versand) liegen dort, nicht auf dieser Domain.
# googletagmanager.com und google-analytics.com stehen seit dem 07.09.2026 drin:
#   Google Analytics (G-7Q576T4MFQ) wird nachgeladen, sobald der Besucher im
#   Banner zustimmt. Ohne diese Eintraege verwirft der Browser das Skript still,
#   und die Einwilligung liefe ins Leere.
# Kommt ein neuer Dienst dazu (Karten, Schriften von aussen), muss er hier
# eingetragen werden - sonst blockiert der Browser ihn still.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://romanbecker.de; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://images.ctfassets.net https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://romanbecker.de https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; upgrade-insecure-requests"
</IfModule>
